# Copy to .env and adjust. All vars are optional; defaults live in
# src/inference_optimizer/config/settings.py

INFERENCE_OPTIMIZER_ENVIRONMENT=development
INFERENCE_OPTIMIZER_LOG_LEVEL=INFO
INFERENCE_OPTIMIZER_RESULTS_DIR=results
INFERENCE_OPTIMIZER_MODEL_CACHE_DIR=.cache/models

# Set to 1 to emit JSON logs instead of console-formatted logs (useful for CI).
INFERENCE_OPTIMIZER_LOG_JSON=0
